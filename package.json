{
  "name": "quickquest",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "dev": "pnpm --filter @quickquest/web dev",
    "build": "pnpm --filter @quickquest/web build",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter @quickquest/relay typecheck",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "size": "pnpm build && size-limit",
    "cf:deploy": "pnpm build && pnpm --filter @quickquest/relay run ship",
    "relay:dev": "pnpm build && pnpm --filter @quickquest/relay dev"
  },
  "size-limit": [
    {
      "name": "telefono (/c)",
      "path": [
        "apps/web/dist/assets/index-*.js",
        "apps/web/dist/assets/hooks.module-*.js",
        "apps/web/dist/assets/components-*.js",
        "apps/web/dist/assets/src-*.js",
        "apps/web/dist/assets/router-*.js",
        "apps/web/dist/assets/index-*.css",
        "apps/web/dist/assets/components-*.css",
        "apps/web/dist/assets/src-*.css",
        "apps/web/dist/assets/ControllerApp-*.js",
        "apps/web/dist/assets/ControllerApp-*.css",
        "apps/web/dist/assets/burst-*.js",
        "apps/web/dist/assets/compat.module-*.js"
      ],
      "limit": "100 KB"
    },
    {
      "name": "telefono, pad del golf",
      "path": [
        "apps/web/dist/assets/GolfPad-*.js",
        "apps/web/dist/assets/GolfPad-*.css"
      ],
      "limit": "15 KB"
    },
    {
      "name": "home (/)",
      "path": [
        "apps/web/dist/assets/index-*.js",
        "apps/web/dist/assets/hooks.module-*.js",
        "apps/web/dist/assets/components-*.js",
        "apps/web/dist/assets/src-*.js",
        "apps/web/dist/assets/router-*.js",
        "apps/web/dist/assets/index-*.css",
        "apps/web/dist/assets/components-*.css",
        "apps/web/dist/assets/src-*.css"
      ],
      "limit": "150 KB"
    },
    {
      "name": "lobby (/stanza)",
      "path": [
        "apps/web/dist/assets/index-*.js",
        "apps/web/dist/assets/hooks.module-*.js",
        "apps/web/dist/assets/components-*.js",
        "apps/web/dist/assets/src-*.js",
        "apps/web/dist/assets/router-*.js",
        "apps/web/dist/assets/index-*.css",
        "apps/web/dist/assets/components-*.css",
        "apps/web/dist/assets/src-*.css",
        "apps/web/dist/assets/Lobby-*.js",
        "apps/web/dist/assets/Lobby-*.css",
        "apps/web/dist/assets/compat.module-*.js"
      ],
      "limit": "150 KB"
    }
  ],
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@playwright/test": "^1.64.1",
    "@preact/preset-vite": "^2.10.6",
    "@size-limit/file": "^14.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^30.1.3",
    "preact": "^10.29.8",
    "size-limit": "^14.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-mkcert": "^2.1.0",
    "vitest": "^5.1.0",
    "wrangler": "^4.157.0"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@types/three": "^0.187.0",
    "three": "^0.187.0"
  }
}
